              <stddev>0.00524</stddev>
              <bias_mean>0.002</bias_mean>
              <bias_stddev>0.0</bias_stddev>
              <precision>0.00107</precision>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00186</stddev>
              <bias_mean>0.001</bias_mean>
              <bias_stddev>0.0</bias_stddev>
              <precision>0.0024</precision>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00186</stddev>
              <bias_mean>0.001</bias_mean>
              <bias_stddev>0.0</bias_stddev>
              <precision>0.0024</precision>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.00186</stddev>
              <bias_mean>0.001</bias_mean>
              <bias_stddev>0.0</bias_stddev>
              <precision>0.0024</precision>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
