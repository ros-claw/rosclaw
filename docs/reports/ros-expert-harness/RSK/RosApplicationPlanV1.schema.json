{
  "$defs": {
    "ApplicationRequestV1": {
      "additionalProperties": false,
      "properties": {
        "task_class": {
          "enum": [
            "navigate_to_pose",
            "complete_area_cleaning"
          ],
          "title": "Task Class",
          "type": "string"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExistingRos2ControlV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "evidence_domain": {
          "const": "SIMULATION",
          "default": "SIMULATION",
          "title": "Evidence Domain",
          "type": "string"
        },
        "component_policies": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Component Policies",
          "type": "array"
        }
      },
      "required": [
        "task_class",
        "source_revision",
        "component_policies"
      ],
      "title": "ApplicationRequestV1",
      "type": "object"
    },
    "ExistingRos2ControlV1": {
      "additionalProperties": false,
      "properties": {
        "command_topic": {
          "maxLength": 512,
          "minLength": 2,
          "title": "Command Topic",
          "type": "string"
        },
        "consumer_node": {
          "maxLength": 512,
          "minLength": 2,
          "title": "Consumer Node",
          "type": "string"
        },
        "message_type": {
          "enum": [
            "geometry_msgs/msg/Twist",
            "geometry_msgs/msg/TwistStamped"
          ],
          "title": "Message Type",
          "type": "string"
        },
        "driver_package": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Driver Package",
          "type": "string"
        },
        "interface_kind": {
          "const": "EXISTING_ROS2_TOPIC",
          "default": "EXISTING_ROS2_TOPIC",
          "title": "Interface Kind",
          "type": "string"
        },
        "declaration": {
          "const": "OPERATOR_SELECTED_PREREQUISITE_NOT_AUTHORITY",
          "default": "OPERATOR_SELECTED_PREREQUISITE_NOT_AUTHORITY",
          "title": "Declaration",
          "type": "string"
        }
      },
      "required": [
        "command_topic",
        "consumer_node",
        "message_type",
        "driver_package"
      ],
      "title": "ExistingRos2ControlV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rosclaw.ros_application_plan.v1",
      "default": "rosclaw.ros_application_plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "graph_hash": {
      "title": "Graph Hash",
      "type": "string"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "evidence_domain": {
      "enum": [
        "SEALED_REPLAY",
        "OBSERVATION"
      ],
      "title": "Evidence Domain",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "source_urdf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Urdf Sha256",
      "type": "string"
    },
    "requirements_hash": {
      "title": "Requirements Hash",
      "type": "string"
    },
    "installed_manifests_hash": {
      "title": "Installed Manifests Hash",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ApplicationRequestV1"
    },
    "status": {
      "enum": [
        "ABSTAIN",
        "NEEDS_DRIVER",
        "NEEDS_READ_ONLY_PROBE",
        "NEEDS_DEPENDENCIES",
        "INCOMPATIBLE",
        "NEEDS_APPLICATION_BRINGUP",
        "NEEDS_SEPARATE_COVERAGE_BINDING",
        "CONDITIONAL_REUSE_STAGING"
      ],
      "title": "Status",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Reasons",
      "type": "array"
    },
    "target_capability_graph": {
      "additionalProperties": true,
      "title": "Target Capability Graph",
      "type": "object"
    },
    "component_compatibility": {
      "additionalProperties": true,
      "title": "Component Compatibility",
      "type": "object"
    },
    "required_packages": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Required Packages",
      "type": "array"
    },
    "missing_package_policies": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Missing Package Policies",
      "type": "array"
    },
    "navigation_observation_review": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Navigation Observation Review"
    },
    "validation_plan": {
      "default": [
        "independent_original_driver_package_endpoint_and_manifest_review",
        "review_pinned_reused_launch_params_BT_and_adapter_no_guessed_control_interface",
        "new_owned_isolated_SIM_World_with_original_URDF_physics_and_Source_binding",
        "fresh_full_L1_READY_and_new_immutable_Body_before_any_action",
        "two_canonical_MCP_rosclawd_navigation_receipts_with_independent_stop",
        "zero_contacts_source_continuity_unchanged_500ms_source_250ms_proof_and_Body_limits",
        "coverage_and_cleaner_are_separate_bindings_and_independent_measured_verification"
      ],
      "items": {
        "type": "string"
      },
      "title": "Validation Plan",
      "type": "array"
    },
    "scope": {
      "const": "EXISTING_ROS2_DRIVER_COMPONENT_REUSE_NOT_DRIVER_GENERATION",
      "default": "EXISTING_ROS2_DRIVER_COMPONENT_REUSE_NOT_DRIVER_GENERATION",
      "title": "Scope",
      "type": "string"
    },
    "execution_authority": {
      "const": "NONE",
      "default": "NONE",
      "title": "Execution Authority",
      "type": "string"
    },
    "source_authentication": {
      "const": "NOT_ESTABLISHED_BY_HASH",
      "default": "NOT_ESTABLISHED_BY_HASH",
      "title": "Source Authentication",
      "type": "string"
    },
    "current_l1": {
      "const": "NOT_EVALUATED",
      "default": "NOT_EVALUATED",
      "title": "Current L1",
      "type": "string"
    },
    "physical_acceptance": {
      "const": "NOT_RUN",
      "default": "NOT_RUN",
      "title": "Physical Acceptance",
      "type": "string"
    },
    "operator_review": {
      "const": "REQUIRED_BEFORE_NEW_WORLD",
      "default": "REQUIRED_BEFORE_NEW_WORLD",
      "title": "Operator Review",
      "type": "string"
    }
  },
  "required": [
    "plan_hash",
    "snapshot_hash",
    "graph_hash",
    "source_ref",
    "evidence_domain",
    "reviewed_at",
    "source_urdf_sha256",
    "requirements_hash",
    "installed_manifests_hash",
    "request",
    "status",
    "reasons",
    "target_capability_graph",
    "component_compatibility",
    "required_packages",
    "missing_package_policies"
  ],
  "title": "RosApplicationPlanV1",
  "type": "object"
}
