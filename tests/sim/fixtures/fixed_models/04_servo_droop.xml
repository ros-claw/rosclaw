<mujoco model="servo_droop_fixed">
  <worldbody>
    <body name="base" pos="0 0 0.5">
      <joint name="shoulder" type="hinge" axis="0 1 0" damping="50.0"/>
      <geom name="base_geom" type="capsule" size="0.05 0.2" mass="0.1"/>
      <body name="arm" pos="0.2 0 0">
        <joint name="elbow" type="hinge" axis="0 1 0" damping="50.0"/>
        <geom name="heavy" type="box" size="0.05 0.05 0.05" mass="8.0" pos="0.3 0 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_servo" joint="shoulder" kp="5000" ctrlrange="-3 3"/>
    <position name="elbow_servo" joint="elbow" kp="5000" ctrlrange="-3 3"/>
  </actuator>
</mujoco>
