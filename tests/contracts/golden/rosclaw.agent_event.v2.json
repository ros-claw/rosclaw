    "model_visible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Visible"
    }
  },
  "required": [
    "event_id",
    "mission_id",
    "timestamp",
    "type"
