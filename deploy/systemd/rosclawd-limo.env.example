# ROS 1 environment for the isolated LIMO rosclawd service.
#
# Install the generated limo_base Python message package under
# /opt/rosclaw/ros1-python2/limo_base.  Do not expose an operator home or the
# whole catkin workspace through ProtectHome just to load one message type.
ROS_MASTER_URI=http://localhost:11311
ROS_DISTRO=melodic
PYTHONPATH=/opt/rosclaw/ros1-python2:/opt/ros/melodic/lib/python2.7/dist-packages
ROS_PACKAGE_PATH=/opt/ros/melodic/share
PATH=/opt/ros/melodic/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ROSCLAW_LIMO_PULSE_SERVER=unix:/run/rosclaw/pulse/native
