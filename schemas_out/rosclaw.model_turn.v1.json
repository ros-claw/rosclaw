{
  "$defs": {
    "ModelUsage": {
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": "rosclaw.model_usage.v1",
          "default": "rosclaw.model_usage.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "cost_microunits": {
          "default": 0,
          "title": "Cost Microunits",
          "type": "integer"
        }
      },
      "title": "ModelUsage",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "const": "rosclaw.tool_call.v1",
          "default": "rosclaw.tool_call.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments_json": {
          "default": "{}",
          "title": "Arguments Json",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "rosclaw.model_turn.v1",
      "default": "rosclaw.model_turn.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "turn_id": {
      "title": "Turn Id",
      "type": "string"
    },
    "mission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Id"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "profile": {
      "default": "",
      "title": "Profile",
      "type": "string"
    },
    "content": {
      "default": "",
      "title": "Content",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "assistant_message": {
      "additionalProperties": true,
      "title": "Assistant Message",
      "type": "object"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "usage": {
      "$ref": "#/$defs/ModelUsage"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "latency_ms": {
      "default": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "context_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Id"
    },
    "context_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Revision"
    }
  },
  "required": [
    "turn_id",
    "provider",
    "model"
  ],
  "title": "rosclaw.model_turn.v1",
  "type": "object",
  "$id": "rosclaw://schemas/rosclaw.model_turn.v1"
}
